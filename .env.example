GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Güvenlik katmanı (guvenlik.py) ──
# simulasyon: sahte sensör (test için) | gercek: VL53L0X (I2C) | kapali: sensör yok, mesafe kameradan
SENSOR_MODU=simulasyon
# Çarpışmaya bu kadar saniye kala tıklamaya başla / "Dur" de
TTC_UYARI_S=2.0
TTC_ACIL_S=1.0
# Bundan yavaş yaklaşma (m/s) "duruyor" sayılır, uyarı verilmez
MIN_YAKLASMA_HIZI=0.25
# Sensörün okuma gürültüsü (m). Dururken yanlış uyarı geliyorsa artır
SENSOR_GURULTU_M=0.025
# Titreşim motorunun GPIO (BCM) numarası, boşsa kapalı
TITRESIM_PIN=
# Fiziksel düğmenin GPIO (BCM) numarası, boşsa klavye (d / SPACE / r)
DUGME_PIN=

# ── Yapay zekâ ──
# live: Gemini Live (sesli, hızlı), bağlı değilken otomatik REST'e döner | rest: sadece REST
AI_MOTORU=live
# Önemli olay kontrolü aralığı (sn). 0 = kapalı. Her kontrol bir kare gönderir, kotayı kullanır
OLAY_ARALIGI_S=5
# Ev modunda eşya hafızası için kare kontrol aralığı (sn), 0 = kapalı
ESYA_ARALIGI_S=8

# ── Cihaz üstü nesne tanıma (YOLO) ve jüri paneli ──
YOLO=1
YOLO_ARALIK_S=1.0
PANEL_PORT=8080
TELEFON_PORT=8443

# ── Kameradan mesafe (derinlik yapay zekâsı, mesafe.py) ──
# mod: ev modunda iç mekân, sokak modunda dış mekân modeli | ic / dis: her zaman o model
DERINLIK_MODELI=mod
DERINLIK_ARALIK_S=2.0
# Gerçek / gösterilen mesafe. Test: 3 m'deki kişiyi 4 m gösterdi → 0,75. 1-2-3 m testiyle güncelle
DERINLIK_CARPAN=0.75
# Sensör kapalıyken sokak modunda kameradan kaba yaklaşma uyarısı (1 = açık)
KAMERA_UYARI=1
