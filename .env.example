GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Güvenlik katmanı (guvenlik.py) ──
# simulasyon: sahte sensör (test için) | gercek: VL53L0X (I2C) | kapali: sensör yok, mesafe kameradan
SENSOR_MODU=simulasyon
# Çarpışmaya bu kadar saniye kala tıklamaya başla / "Dur" de
TTC_UYARI_S=2.0
TTC_ACIL_S=1.0
# Bundan yavaş yaklaşma (m/s) "duruyor" sayılır, uyarı verilmez
MIN_YAKLASMA_HIZI=0.25
# Sensörün okuma gürültüsü (m). Dururken yanlış uyarı geliyorsa artır
SENSOR_GURULTU_M=0.025
# Titreşim motorunun GPIO (BCM) numarası, boşsa kapalı
TITRESIM_PIN=
# Fiziksel düğmenin GPIO (BCM) numarası, boşsa klavye (d / SPACE / r)
DUGME_PIN=

# ── Yapay zekâ ──
# live: Gemini Live (sesli, hızlı), bağlı değilken otomatik REST'e döner | rest: sadece REST
AI_MOTORU=live
# Önemli olay kontrolü aralığı (sn). 0 = kapalı. Her kontrol bir kare gönderir, kotayı kullanır
OLAY_ARALIGI_S=8
# Ev modunda eşya hafızası için kare kontrol aralığı (sn), 0 = kapalı
ESYA_ARALIGI_S=8

# ── Cihaz üstü nesne tanıma (YOLO) ve jüri paneli ──
YOLO=1
YOLO_ARALIK_S=1.0
PANEL_PORT=8080
TELEFON_PORT=8443

# ── Kameradan mesafe (derinlik yapay zekâsı, mesafe.py) ──
# ic: her iki modda iç mekân modeli (yakın mesafede en doğrusu, önerilen) | dis | mod (ev→iç, sokak→dış)
DERINLIK_MODELI=ic
DERINLIK_ARALIK_S=0.6
# Gerçek / gösterilen mesafe (1-2-3 m testiyle bulunur). 0,75 eski dış mekân modeliyle ölçülmüştü
DERINLIK_CARPAN=1.0
# Sensör kapalıyken sokak modunda kameradan engel uyarısı: "Önünde sandalye var, sağdan geç"
KAMERA_UYARI=1
# Yürüme yolunda bundan yakın engel için uyarı / bip + "Dur" (metre)
ENGEL_UYARI_M=1.5
ENGEL_DUR_M=0.7
# Ev modunda da engel uyarısı (0 = sadece sokakta)
ENGEL_UYARI_EV=0

# Bluetooth kulaklık: koparsa otomatik yeniden bağlanır (boşsa kapalı)
KULAKLIK_MAC=20:23:03:25:87:1C

# Sokak modunda otomatik anlatım (sn): önündeki en önemli şey / genel çevre özeti
SOKAK_TARIF_S=30
SOKAK_CEVRE_S=60

# Kendiliğinden konuşurken metre söylensin mi (kalibrasyondan sonra 1 yapılabilir). 0: yakında/uzakta
MESAFE_SAYILI=0
